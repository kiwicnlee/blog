<article class="post-card card-tone-<%= (index % 3) + 1 %>">
  <a class="card-art" href="<%- url_for(post.path) %>" aria-label="阅读<%= post.title %>">
    <span class="card-art-ring"></span><span class="card-art-square"></span><span class="card-art-dot"></span>
    <span class="card-art-index"><%= String(index + 1).padStart(2, '0') %> / FIELD NOTES</span>
    <span class="card-art-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="card-meta">
    <span><%= date(post.date, 'YYYY.MM.DD') %></span>
    <% if (post.categories && post.categories.length) { %><span class="meta-dot">·</span><span><%= post.categories.data[0].name %></span><% } %>
  </div>
  <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
  <p><%= post.description || strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').slice(0, 92) %></p>
  <a class="text-link" href="<%- url_for(post.path) %>">阅读全文 <span aria-hidden="true">→</span></a>
</article>
