<article class="post-card">
  <a class="post-card-link" href="<%- url_for(post.path) %>" aria-label="阅读<%= post.title %>">
    <span class="card-index"><%= String(index + 1).padStart(2, '0') %></span>
    <span class="card-content">
      <span class="card-meta"><% if (post.categories && post.categories.length) { %><span class="card-category"><%= post.categories.data[0].name %></span><% } %><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time></span>
      <strong class="card-title"><%= post.title %></strong>
      <span class="card-excerpt"><%= post.description || strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').slice(0, 100) %></span>
    </span>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </a>
</article>
