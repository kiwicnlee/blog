<aside class="site-directory" aria-label="站点目录">
  <div class="sidebar-sticky">
    <div class="directory-heading">
      <div><p class="sidebar-eyebrow">EXPLORE / 站点目录</p><h2>浏览博客</h2></div>
      <button class="directory-toggle" type="button" aria-expanded="false" aria-controls="directory-links"><span class="directory-toggle-label">展开目录</span><span aria-hidden="true">⌄</span></button>
    </div>
    <nav id="directory-links" class="directory-links" aria-label="博客目录">
      <a class="directory-link<%= is_home() ? ' active' : '' %>" href="<%- url_for('/') %>"><span>首页概览</span><span aria-hidden="true">↗</span></a>
      <a class="directory-link<%= is_archive() ? ' active' : '' %>" href="<%- url_for('/archives/') %>"><span>全部文章</span><span><%= site.posts.length %></span></a>
      <div class="directory-group">
        <p class="directory-group-title">文档目录</p>
        <% const sections = site.data.navigation.sections;
           const assigned = new Set();
           sections.forEach(function(section) {
             const prefix = '_posts/' + section.directory + '/';
             const posts = site.posts.data.filter(post => post.source.startsWith(prefix)).sort((a, b) => b.date.valueOf() - a.date.valueOf());
             posts.forEach(post => assigned.add(post.source));
        %>
          <details class="directory-section" open>
            <summary class="directory-section-heading<%= (is_post() && page.source.startsWith(prefix)) || (is_category() && page.category === section.category) ? ' active' : '' %>"><span><%= section.title %></span><span class="directory-section-count"><%= posts.length %> 篇 <span aria-hidden="true">⌄</span></span></summary>
            <div class="directory-section-posts">
              <% posts.forEach(function(post) { %>
                <a class="directory-article<%= is_post() && page.path === post.path ? ' active' : '' %>" href="<%- url_for(post.path) %>"<% if (is_post() && page.path === post.path) { %> aria-current="page"<% } %>><%= post.title %></a>
              <% }) %>
              <a class="directory-section-more" href="<%- url_for('/categories/' + section.category + '/') %>">查看该分类全部文章 →</a>
            </div>
          </details>
        <% });
           const unassigned = site.posts.data.filter(post => !assigned.has(post.source)).sort((a, b) => b.date.valueOf() - a.date.valueOf());
           if (unassigned.length) { %>
          <details class="directory-section" open>
            <summary class="directory-section-heading"><span>其他文章</span><span class="directory-section-count"><%= unassigned.length %> 篇 <span aria-hidden="true">⌄</span></span></summary>
            <div class="directory-section-posts">
              <% unassigned.forEach(function(post) { %><a class="directory-article<%= is_post() && page.path === post.path ? ' active' : '' %>" href="<%- url_for(post.path) %>"><%= post.title %></a><% }) %>
            </div>
          </details>
        <% } %>
      </div>
      <a class="directory-link directory-about<%= page.path === 'about/index.html' ? ' active' : '' %>" href="<%- url_for('/about/') %>"><span>关于 Kiwi</span><span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</aside>
