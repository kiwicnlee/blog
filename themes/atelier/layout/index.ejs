<% const firstPage = !page.current || page.current === 1; %>
<% const leadPost = firstPage && page.posts.length ? page.posts.data[0] : null; %>
<div id="top"></div>
<% if (firstPage) { %>
  <section class="home-intro container" aria-labelledby="home-title">
    <div class="intro-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span><%= theme.hero_label %></p>
      <h1 id="home-title"><%= theme.hero_title %><br><%= theme.hero_title_second %></h1>
      <p class="intro-description"><%= theme.hero_description %></p>
      <div class="hero-actions">
        <a class="button-primary" href="<%- url_for('/archives/') %>">浏览全部文章 <span aria-hidden="true">↗</span></a>
        <a class="button-secondary" href="<%- url_for('/about/') %>">关于本站 <span aria-hidden="true">→</span></a>
      </div>
      <p class="intro-footnote">技术笔记 / 生活观察 / 持续更新</p>
    </div>
    <% if (leadPost) { %>
      <a class="lead-story" href="<%- url_for(leadPost.path) %>" aria-label="阅读最新文章：<%= leadPost.title %>">
        <span class="lead-top"><span class="lead-label">最新发布</span><span>NO. 01 / LATEST</span></span>
        <span class="lead-category"><% if (leadPost.categories && leadPost.categories.length) { %><%= leadPost.categories.data[0].name %><% } else { %>文章手记<% } %></span>
        <strong class="lead-title"><%= leadPost.title %></strong>
        <span class="lead-description"><%= leadPost.description || strip_html(leadPost.excerpt || leadPost.content).replace(/\s+/g, ' ').slice(0, 90) %></span>
        <span class="lead-bottom"><time datetime="<%= date_xml(leadPost.date) %>"><%= date(leadPost.date, 'YYYY.MM.DD') %></time><span>阅读全文 <b aria-hidden="true">↗</b></span></span>
      </a>
    <% } %>
  </section>
  <nav id="topics-heading" class="topic-rail container" aria-label="按主题阅读">
    <a href="<%- url_for('/categories/机器人技术/') %>"><span class="topic-marker technical"></span><span><small>01 / ENGINEERING</small><strong>机器人与技术</strong></span><b aria-hidden="true">↗</b></a>
    <a href="<%- url_for('/categories/生活随笔/') %>"><span class="topic-marker everyday"></span><span><small>02 / EVERYDAY</small><strong>生活与随笔</strong></span><b aria-hidden="true">↗</b></a>
  </nav>
<% } %>
<section class="posts-section container" aria-labelledby="latest-heading">
  <div class="section-head">
    <div><p class="section-label">THE JOURNAL / 文章目录</p><h2 id="latest-heading"><%= theme.featured_label %></h2></div>
    <a class="section-link" href="<%- url_for('/archives/') %>">查看归档 <span aria-hidden="true">↗</span></a>
  </div>
  <% if (page.posts.length) { %>
    <div class="posts-list">
      <% page.posts.each(function(post, index) { if (!(leadPost && index === 0)) { %>
        <%- partial('_partial/post-card', {post: post, index: index}) %>
      <% } }) %>
    </div>
    <% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text: '← 上一页', next_text: '下一页 →'}) %></nav><% } %>
  <% } else { %><p class="empty-state">第一篇文章正在路上。稍后再来看看吧。</p><% } %>
</section>
<% if (firstPage) { %>
  <section id="about-heading" class="closing-note"><div class="container closing-inner"><div><p class="section-label">ABOUT THIS JOURNAL / 关于这里</p><h2>把每一次探索，写成下一次出发的线索。</h2></div><a href="<%- url_for('/about/') %>">了解这个博客 <span aria-hidden="true">↗</span></a></div></section>
<% } %>
