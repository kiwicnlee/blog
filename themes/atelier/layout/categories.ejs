<div id="top"></div><section class="page-banner container"><p class="section-label">EXPLORE BY TOPIC / 按主题探索</p><h1>文章分类<span class="heading-mark">.</span></h1><p>在不同的主题里，找到你感兴趣的故事。</p></section>
<section class="category-section container"><div class="category-grid"><% site.categories.sort('name').each(function(category, index) { %><a class="category-card" href="<%- url_for(category.path) %>"><span class="category-index"><%= String(index + 1).padStart(2, '0') %> / TOPIC</span><span class="category-name"><%= category.name %></span><span class="category-bottom"><%= category.posts.length %> 篇文章 <b aria-hidden="true">↗</b></span></a><% }) %></div></section>
