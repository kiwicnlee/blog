<% const postToc = toc(page.content, {list_number: false, min_depth: 2, max_depth: 3}); %>
<div id="top"></div>
<article class="post-page container">
  <header class="post-header">
    <a class="back-link" href="<%- url_for('/archives/') %>">← 返回文章列表</a>
    <div class="post-meta"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY.MM.DD') %></time><% if (page.categories && page.categories.length) { %><span>·</span><a href="<%- url_for(page.categories.data[0].path) %>"><%= page.categories.data[0].name %></a><% } %></div>
    <h1><%= page.title %></h1>
    <p><%= page.description || config.subtitle %></p>
  </header>
  <div class="post-divider"><span>✳</span></div>
  <div class="post-body-layout<%= postToc ? '' : ' without-toc' %>">
    <% if (postToc) { %>
      <aside class="post-sidebar" aria-label="本页目录">
        <div class="post-sidebar-inner">
          <p class="toc-title">本页目录 <span>ON THIS PAGE</span></p>
          <nav class="toc-nav" aria-label="文章目录"><%- postToc %></nav>
          <a class="toc-back" href="#top">返回顶部 ↑</a>
        </div>
      </aside>
    <% } %>
    <div class="prose"><%- page.content %></div>
  </div>
  <footer class="post-end"><span>感谢读到这里。</span><a href="<%- url_for('/archives/') %>">继续探索更多文章 ↗</a></footer>
</article>
